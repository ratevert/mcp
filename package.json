{
  "name": "ratevert-mcp",
  "version": "0.3.1",
  "description": "A read-only Model Context Protocol server for Ratevert asset conversions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "smoke": "node smoke-test.mjs",
    "test": "node --test server.test.mjs",
    "verify:release": "node scripts/verify-release-contents.mjs"
  },
  "files": [
    "server.mjs",
    "monitoring.mjs",
    "ratevert-client.mjs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sentry/node": "10.70.0",
    "express": "5.2.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "ajv": {
      "fast-uri": "3.1.8"
    },
    "body-parser": "2.3.0",
    "hono": "4.13.13",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "ip-address": "10.7.3"
  }
}
